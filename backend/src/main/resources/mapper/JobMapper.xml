<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.recruitmentsystem.mapper.JobMapper">

    <resultMap id="JobMap" type="com.example.recruitmentsystem.entity.Job">
        <id property="id" column="id"/>
        <result property="hrUserId" column="hr_user_id"/>
        <result property="companyId" column="company_id"/>
        <result property="industryId" column="industry_id"/>
        <result property="cityId" column="city_id"/>
        <result property="province" column="province"/>
        <result property="salaryMin" column="salary_min"/>
        <result property="salaryMax" column="salary_max"/>
        <result property="description" column="description"/>
        <result property="requirements" column="requirements"/>
        <result property="keywords" column="keywords"/>
        <result property="status" column="status"/>
        <result property="auditStatus" column="audit_status"/>
        <result property="auditNote" column="audit_note"/>
        <result property="publishedAt" column="published_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!--
        候选人端职位分页查询（仅 ONLINE）。
        v0.5 新增：cityName（城市名文本搜索）+ favoritedOnly（只看我收藏的）。
        favoritedOnly=true 时必须传 candidateId，SQL 会 INNER JOIN favorite_job。
    -->
    <select id="selectPageForCandidate" resultMap="JobMap">
        SELECT j.*
        FROM job j
        WHERE j.is_deleted = 0
          AND j.status = 'ONLINE'
          <!-- v0.4 修订：取消 audit_status 过滤（无审核流） -->
          <if test="keyword != null and keyword != ''">
              AND (j.title LIKE CONCAT('%', #{keyword}, '%')
                   OR j.description LIKE CONCAT('%', #{keyword}, '%'))
          </if>
          <if test="industryId != null">
              AND j.industry_id = #{industryId}
          </if>
          <if test="cityId != null">
              AND j.city_id = #{cityId}
          </if>
          <if test="province != null and province != ''">
              AND j.province = #{province}
          </if>
          <!-- v0.5 新增：按城市名（dict_city.name）过滤 -->
          <if test="cityName != null and cityName != ''">
              AND j.city_id IN (
                  SELECT id FROM dict_city
                  WHERE name = #{cityName} AND is_deleted = 0
              )
          </if>
          <!-- v0.5 新增：只看我收藏的 -->
          <if test="favoritedOnly != null and favoritedOnly == true">
              AND EXISTS (
                  SELECT 1 FROM favorite_job f
                  WHERE f.job_id = j.id
                    AND f.candidate_id = #{candidateId}
                    AND f.is_deleted = 0
              )
          </if>
        ORDER BY
            <choose>
                <when test="sort == 'salary'">j.salary_max DESC</when>
                <otherwise>j.published_at DESC</otherwise>
            </choose>
    </select>

    <!--
        批量查询 candidateId 收藏的 jobId 列表。
        用于 listForCandidate 二次填充 favorited 字段，避免前端 toggleFavorite 后刷新状态丢失。
    -->
    <select id="selectFavoriteJobIds" resultType="java.lang.Long">
        SELECT job_id
        FROM favorite_job
        WHERE candidate_id = #{candidateId}
          AND is_deleted = 0
          <if test="jobIds != null and jobIds.size() > 0">
              AND job_id IN
              <foreach collection="jobIds" item="jid" open="(" close=")" separator=",">
                  #{jid}
              </foreach>
          </if>
    </select>

    <!--
        v0.7.3：候选人首页"推荐职位"分页查询。
        偏好字段全空 → 退化为最新发布 5 条 ONLINE 职位。
        否则按"候选集合"宽筛：行业 OR city_id OR province OR 任一关键词 LIKE 三字段。
        多级排序（Tier 1-4）由 Java 在内存中按 matchScore 排；SQL 仅做基本过滤。
        数据量小（< 100 职位）适合此方案。
    -->
    <select id="selectPageForRecommendation" resultMap="JobMap">
        SELECT j.*
        FROM job j
        WHERE j.is_deleted = 0
          AND j.status = 'ONLINE'
          <choose>
              <when test="industryId != null">
                  AND (j.industry_id = #{industryId}
                  <if test="cityId != null">
                      OR j.city_id = #{cityId}
                  </if>
                  <if test="province != null and province != ''">
                      OR j.province = #{province}
                  </if>
                  <if test="keywordTokens != null and keywordTokens.size() > 0">
                      <foreach collection="keywordTokens" item="tk" open=" OR (" close=")" separator=" OR ">
                          j.title LIKE CONCAT('%', #{tk}, '%')
                          OR j.requirements LIKE CONCAT('%', #{tk}, '%')
                          OR j.keywords LIKE CONCAT('%', #{tk}, '%')
                      </foreach>
                  </if>)
              </when>
              <when test="cityId != null">
                  AND (j.city_id = #{cityId}
                  <if test="province != null and province != ''">
                      OR j.province = #{province}
                  </if>
                  <if test="keywordTokens != null and keywordTokens.size() > 0">
                      <foreach collection="keywordTokens" item="tk" open=" OR (" close=")" separator=" OR ">
                          j.title LIKE CONCAT('%', #{tk}, '%')
                          OR j.requirements LIKE CONCAT('%', #{tk}, '%')
                          OR j.keywords LIKE CONCAT('%', #{tk}, '%')
                      </foreach>
                  </if>)
              </when>
              <when test="province != null and province != ''">
                  AND (j.province = #{province}
                  <if test="keywordTokens != null and keywordTokens.size() > 0">
                      <foreach collection="keywordTokens" item="tk" open=" OR (" close=")" separator=" OR ">
                          j.title LIKE CONCAT('%', #{tk}, '%')
                          OR j.requirements LIKE CONCAT('%', #{tk}, '%')
                          OR j.keywords LIKE CONCAT('%', #{tk}, '%')
                      </foreach>
                  </if>)
              </when>
              <when test="keywordTokens != null and keywordTokens.size() > 0">
                  AND <foreach collection="keywordTokens" item="tk" open="(" close=")" separator=" OR ">
                      j.title LIKE CONCAT('%', #{tk}, '%')
                      OR j.requirements LIKE CONCAT('%', #{tk}, '%')
                      OR j.keywords LIKE CONCAT('%', #{tk}, '%')
                  </foreach>
              </when>
              <otherwise>
                  <!-- 全部条件都没传：退化为最新发布（不加额外过滤） -->
              </otherwise>
          </choose>
        ORDER BY j.published_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
